<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_restaurant_expense_seller_own" model="ir.rule">
        <field name="name">Restaurant Seller: own expenses</field>
        <field name="model_id" ref="model_restaurant_expense"/>
        <field name="groups" eval="[Command.link(ref('group_restaurant_seller'))]"/>
        <field name="domain_force">[('purchased_by', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Admin implies Seller; this group rule widens admin access to every expense. -->
    <record id="rule_restaurant_expense_admin_all" model="ir.rule">
        <field name="name">Restaurant Admin: all expenses</field>
        <field name="model_id" ref="model_restaurant_expense"/>
        <field name="groups" eval="[Command.link(ref('group_restaurant_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
