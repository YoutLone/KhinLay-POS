<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_restaurant_pos" model="ir.module.category">
        <field name="name">Restaurant POS</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_restaurant_pos" model="res.groups.privilege">
        <field name="name">Restaurant POS</field>
        <field name="category_id" ref="module_category_restaurant_pos"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_restaurant_seller" model="res.groups">
        <field name="name">Restaurant Seller</field>
        <field name="comment">Create and pay restaurant orders, view ingredient stock, and manage own expenses.</field>
        <field name="privilege_id" ref="privilege_restaurant_pos"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('point_of_sale.group_pos_user'))
        ]"/>
    </record>

    <record id="group_restaurant_admin" model="res.groups">
        <field name="name">Restaurant Admin</field>
        <field name="comment">Manage all restaurant records and view income and profit reports.</field>
        <field name="privilege_id" ref="privilege_restaurant_pos"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('group_restaurant_seller')),
            Command.link(ref('point_of_sale.group_pos_manager'))
        ]"/>
    </record>
</odoo>
