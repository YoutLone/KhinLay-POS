<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_menu_category_list" model="ir.ui.view">
        <field name="name">restaurant.menu.category.list</field>
        <field name="model">restaurant.menu.category</field>
        <field name="arch" type="xml">
            <list string="Menu Categories">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_menu_category_form" model="ir.ui.view">
        <field name="name">restaurant.menu.category.form</field>
        <field name="model">restaurant.menu.category</field>
        <field name="arch" type="xml">
            <form string="Menu Category">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_restaurant_menu_categories" model="ir.actions.act_window">
        <field name="name">Menu Categories</field>
        <field name="res_model">restaurant.menu.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_restaurant_menu_item_list" model="ir.ui.view">
        <field name="name">restaurant.menu.item.list</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <list string="Menu Items">
                <field name="name"/>
                <field name="category_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="in_stock"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_menu_item_form" model="ir.ui.view">
        <field name="name">restaurant.menu.item.form</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <form string="Menu Item">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Menu item name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="in_stock"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id"/>
                            <field name="pos_product_id" groups="restaurant_pos.group_restaurant_admin"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe this menu item"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_restaurant_menu_item_kanban" model="ir.ui.view">
        <field name="name">restaurant.menu.item.kanban</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="currency_id"/>
                <field name="in_stock"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <main class="pe-2">
                            <div class="h5 mb-1"><field name="name"/></div>
                            <div class="text-muted mb-1"><field name="category_id"/></div>
                            <div>
                                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </div>
                            <span t-if="record.in_stock.raw_value" class="badge text-bg-success mt-2">Available</span>
                            <span t-else="" class="badge text-bg-secondary mt-2">Unavailable</span>
                        </main>
                        <aside>
                            <field name="image" widget="image" alt="Menu item"
                                options="{'img_class': 'w-100 object-fit-cover'}"
                                invisible="not image"/>
                        </aside>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_restaurant_menu_item_search" model="ir.ui.view">
        <field name="name">restaurant.menu.item.search</field>
        <field name="model">restaurant.menu.item</field>
        <field name="arch" type="xml">
            <search string="Search Menu Items">
                <field name="name"/>
                <field name="category_id"/>
                <filter name="available" string="Available" domain="[('in_stock', '=', True)]"/>
                <filter name="unavailable" string="Unavailable" domain="[('in_stock', '=', False)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"
                    context="{'active_test': False}"/>
                <group>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_restaurant_menu_items" model="ir.actions.act_window">
        <field name="name">Menu Items</field>
        <field name="res_model">restaurant.menu.item</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_restaurant_menu_item_kanban"/>
        <field name="search_view_id" ref="view_restaurant_menu_item_search"/>
    </record>
</odoo>
