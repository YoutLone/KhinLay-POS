<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_ingredient_list" model="ir.ui.view">
        <field name="name">restaurant.ingredient.list</field>
        <field name="model">restaurant.ingredient</field>
        <field name="arch" type="xml">
            <list string="Ingredients" decoration-danger="is_low_stock">
                <field name="name"/>
                <field name="unit_of_measure"/>
                <field name="current_qty"/>
                <field name="min_qty"/>
                <field name="is_low_stock"/>
                <field name="currency_id" column_invisible="True"
                    groups="restaurant_pos.group_restaurant_admin"/>
                <field name="cost_per_unit" widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                    groups="restaurant_pos.group_restaurant_admin"/>
                <field name="stock_value" widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                    groups="restaurant_pos.group_restaurant_admin"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_ingredient_form" model="ir.ui.view">
        <field name="name">restaurant.ingredient.form</field>
        <field name="model">restaurant.ingredient</field>
        <field name="arch" type="xml">
            <form string="Ingredient">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="unit_of_measure"/>
                            <field name="is_low_stock" readonly="1"/>
                        </group>
                        <group>
                            <field name="current_qty"/>
                            <field name="min_qty"/>
                        </group>
                    </group>
                    <group groups="restaurant_pos.group_restaurant_admin">
                        <field name="cost_per_unit" widget="monetary"
                            options="{'currency_field': 'currency_id'}"/>
                        <field name="currency_id"/>
                        <field name="stock_value" widget="monetary" readonly="1"
                            options="{'currency_field': 'currency_id'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_restaurant_ingredient_search" model="ir.ui.view">
        <field name="name">restaurant.ingredient.search</field>
        <field name="model">restaurant.ingredient</field>
        <field name="arch" type="xml">
            <search string="Search Ingredients">
                <field name="name"/>
                <filter name="low_stock" string="Low Stock"
                    domain="[('is_low_stock', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_restaurant_ingredients" model="ir.actions.act_window">
        <field name="name">Ingredients</field>
        <field name="res_model">restaurant.ingredient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_restaurant_ingredient_search"/>
    </record>

    <record id="action_restaurant_low_stock" model="ir.actions.act_window">
        <field name="name">Low Stock</field>
        <field name="res_model">restaurant.ingredient</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_low_stock', '=', True)]</field>
        <field name="search_view_id" ref="view_restaurant_ingredient_search"/>
    </record>

    <record id="view_restaurant_recipe_list" model="ir.ui.view">
        <field name="name">restaurant.recipe.list</field>
        <field name="model">restaurant.recipe</field>
        <field name="arch" type="xml">
            <list string="Recipes">
                <field name="menu_item_id"/>
                <field name="ingredient_id"/>
                <field name="qty_per_item"/>
                <field name="unit_of_measure"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_recipe_form" model="ir.ui.view">
        <field name="name">restaurant.recipe.form</field>
        <field name="model">restaurant.recipe</field>
        <field name="arch" type="xml">
            <form string="Recipe Ingredient">
                <sheet>
                    <group>
                        <field name="menu_item_id"/>
                        <field name="ingredient_id"/>
                        <field name="qty_per_item"/>
                        <field name="unit_of_measure" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_restaurant_recipes" model="ir.actions.act_window">
        <field name="name">Recipes</field>
        <field name="res_model">restaurant.recipe</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_restaurant_stock_move_list" model="ir.ui.view">
        <field name="name">restaurant.stock.move.list</field>
        <field name="model">restaurant.stock.move</field>
        <field name="arch" type="xml">
            <list string="Ingredient Consumption" create="0" edit="0" delete="0">
                <field name="order_id"/>
                <field name="ingredient_id"/>
                <field name="qty"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="unit_cost" widget="monetary"
                    options="{'currency_field': 'currency_id'}"/>
                <field name="total_cost" widget="monetary"
                    options="{'currency_field': 'currency_id'}"/>
                <field name="reversed"/>
            </list>
        </field>
    </record>

    <record id="action_restaurant_stock_moves" model="ir.actions.act_window">
        <field name="name">Ingredient Consumption</field>
        <field name="res_model">restaurant.stock.move</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_restaurant_pos_consumption_list" model="ir.ui.view">
        <field name="name">restaurant.pos.consumption.list</field>
        <field name="model">restaurant.pos.consumption</field>
        <field name="arch" type="xml">
            <list string="Register Ingredient Consumption" create="0" edit="0" delete="0">
                <field name="pos_order_id"/>
                <field name="ingredient_id"/>
                <field name="qty"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="unit_cost" widget="monetary"
                    options="{'currency_field': 'currency_id'}"/>
                <field name="total_cost" widget="monetary"
                    options="{'currency_field': 'currency_id'}"/>
            </list>
        </field>
    </record>

    <record id="action_restaurant_pos_consumption" model="ir.actions.act_window">
        <field name="name">Register Consumption</field>
        <field name="res_model">restaurant.pos.consumption</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
